{
  "name": "ai-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright BDD automation project for Sauce Demo login coverage with Chrome and Allure reporting",
  "scripts": {
    "bddgen": "bddgen",
    "report:allure": "allure generate allure-results -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:html:open": "playwright show-report playwright-report",
    "report:open": "tsx scripts/run-tests.ts --open-reports-only",
    "test": "tsx scripts/run-tests.ts",
    "test:report": "tsx scripts/run-tests.ts",
    "test:headed": "tsx scripts/run-tests.ts --headed",
    "test:debug": "tsx scripts/run-tests.ts --debug"
  },
  "keywords": [
    "playwright",
    "typescript",
    "bdd",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "allure": "^3.9.0",
    "allure-playwright": "^3.9.0",
    "playwright-bdd": "^9.0.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
